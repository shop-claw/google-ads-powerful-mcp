# ---- Google Ads API credentials (OAuth refresh token flow) ----
# Optional. Google ignores developer tokens since September 2026.
# GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
# Must be issued with the https://www.googleapis.com/auth/adwords scope.
# Run: python scripts/get_refresh_token.py
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
# Manager (MCC) account ID, digits only. Required when accessing client accounts through an MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Alternative to the variables above: path to a google-ads.yaml file.
# SHOPCLAW_GOOGLE_ADS_YAML=/absolute/path/to/google-ads.yaml

# ---- shopclaw safety settings ----
# true = every write tool is blocked. Start here if you only want to test the connection.
SHOPCLAW_READ_ONLY=false
# Hard cap for any daily budget this server will create or set, in the account currency.
SHOPCLAW_MAX_DAILY_BUDGET=100
# Optional comma separated allowlist of customer IDs (digits only). Empty = any account the credentials can reach.
SHOPCLAW_ALLOWED_CUSTOMERS=
# Run the change through Google's validate_only mode when it is staged, so API errors show up before you confirm.
SHOPCLAW_VALIDATE_ON_PREVIEW=true
# How long a staged change stays confirmable, in seconds.
SHOPCLAW_PENDING_TTL_SECONDS=900
# JSON lines audit log of every staged, confirmed, cancelled and failed change.
SHOPCLAW_AUDIT_LOG=~/.shopclaw/audit.jsonl
# Optional: pin the Google Ads API version, for example v23. Empty = library default.
SHOPCLAW_API_VERSION=
